      }
    },
    "prompts": {
      "data-costs": {
        "zh": "查看每个数据源的价格，以及本月在它上面的花费"
      },
      "cost-first": {
        "zh": "在 cx 购买任何数据之前，先知道一个问题要花多少钱"
      }
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
